DATABASE_URL="file:./dev.db"
ADMIN_USER="admin"
ADMIN_PASSWORD="admin123"
AUTH_SECRET="change-me-to-a-long-random-string"
UPLOAD_DIR="./data/uploads"

# Cloudflare Tunnel (Zero Trust → Networks → Tunnels → Create → Docker token)
# Public hostname → http://web:3000
CLOUDFLARE_TUNNEL_TOKEN=""

# Docker / Raspberry Pi notu:
# docker-compose DATABASE_URL'i file:/app/data/prod.db olarak ezer.
# Canlıda ADMIN_PASSWORD ve AUTH_SECRET mutlaka değiştirin.
# CLOUDFLARE_TUNNEL_TOKEN'ı yalnızca .env dosyasına koyun; örnek dosyaya yapıştırmayın.
